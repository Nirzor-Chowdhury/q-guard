# Q-Guard application configuration
QGUARD_ENVIRONMENT=development
QGUARD_API_HOST=127.0.0.1
QGUARD_API_PORT=8000
QGUARD_LOG_LEVEL=INFO
QGUARD_SECURE_MODE=true

# PostgreSQL connection used by later phases.
# Replace CHANGE_THIS before using the database.
QGUARD_DATABASE_URL=postgresql+psycopg://qguard_user:CHANGE_THIS@localhost:5432/qguard

# QKD simulator endpoint used in later phases.
QGUARD_QKD_SIMULATOR_URL=http://127.0.0.1:8100

# Comma-separated browser origins for the future dashboard.
QGUARD_CORS_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# PostgreSQL container variables.
POSTGRES_DB=qguard
POSTGRES_USER=qguard_user
POSTGRES_PASSWORD=CHANGE_THIS